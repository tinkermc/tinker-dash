{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tinker-dash",
  "version": "0.1.0",
  "identifier": "com.tinker.tinker-dash",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tinker Dash",
        "width": 1280,
        "height": 720,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "maximized": false,
        "backgroundColor": "#0b0d10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
